  author      = {Zu, Xinrui and Tao, Qian},
  booktitle   = {International Conference on Machine Learning (ICML)},
  year        = {2022},
  abstract    = {A dimensionality-reduction method that visualizes data of any dimensionality on a 2-D map. We analytically derive a transformation of distance between high- and low-dimensional spaces to match their capacity, and show it provably reduces the intrinsic dimension of high-dimensional data within the maximum-likelihood intrinsic-dimensionality framework.},
